# Server
PORT=3001
NODE_ENV=development

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scraper refresh intervals (cron syntax)
# Live outages: every 5 minutes
CRON_LIVE=*/5 * * * *
# Planned outages: every 30 minutes
CRON_PLANNED=*/30 * * * *

# HTTP request timeout for scraper calls (ms)
SCRAPER_TIMEOUT=15000

# Max retries per scraper on failure
SCRAPER_MAX_RETRIES=3

# SQLite database path (relative to backend/)
DB_PATH=./data/outages.db

# Optional: Proxy URL if providers block direct requests
# HTTP_PROXY=http://proxy.example.com:8080
